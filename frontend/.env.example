# Copy to `.env.local` and adjust. All variables are read at build time by Vite.

# Base URL for the REST API. Relative values work with the dev proxy and same-origin deployments.
VITE_API_BASE_URL=/api

# Deployment label shown in the header: development | production
VITE_APP_ENV=development

# Per-request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Dev server only: where `/api` is proxied to
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Header used to carry the purchase idempotency key.
# ASSUMPTION until API_CONTRACT.md is supplied — confirm the real header name.
VITE_IDEMPOTENCY_HEADER=Idempotency-Key
