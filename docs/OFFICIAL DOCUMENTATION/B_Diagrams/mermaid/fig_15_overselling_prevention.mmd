graph TD
    REQ[Incoming Checkout Request]

    subgraph Defense_Layer_1 [Layer 1: Pessimistic Row Lock]
        L1[SELECT * FROM inventory WHERE product_id = :id FOR UPDATE]
    end

    subgraph Defense_Layer_2 [Layer 2: Conditional Atomic SQL]
        L2[UPDATE inventory SET stock = stock - :qty WHERE id = :id AND stock >= :qty]
        COUNT{Affected Rows == 1?}
    end

    subgraph Defense_Layer_3 [Layer 3: Storage Engine Invariant]
        L3[PostgreSQL Table Check Constraint: CHECK current_stock >= 0]
    end

    SUCCESS[Order Confirmed - HTTP 201]
    ROLLBACK[Transaction Rollback - HTTP 409]

    REQ --> L1
    L1 --> L2
    L2 --> COUNT
    COUNT -->|Yes| L3
    L3 -->|Pass| SUCCESS
    COUNT -->|No| ROLLBACK
